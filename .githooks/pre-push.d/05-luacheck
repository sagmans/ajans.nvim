#!/bin/sh
# Full pinned luacheck run (scripts/lint) on each pushed commit, not just
# HEAD: it also catches Lua committed with hooks off. Named 05 so this check
# (about a second) fails before the slower test and docs runs.
set -eu
cd "$(git rev-parse --show-toplevel)"
# shellcheck disable=SC1090,SC1091  # path exported by .githooks/lib/run-local.sh
. "${HOOK_HELPERS:?run from .githooks (scripts/setup-hooks)}"
# for loop, not `| while`: a failure must exit this script (fail closed).
shas=$(pushed_shas <"$HOOK_STDIN_FILE") || exit 1
shas=$(printf '%s\n' "$shas" | sort -u)
# shellcheck disable=SC2086  # one SHA per word
for sha in $shas; do
	echo "pre-push: scripts/lint at $(git rev-parse --short "$sha")"
	at_sha "$sha" ./scripts/lint || exit 1
done
