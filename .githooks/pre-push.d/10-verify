#!/bin/sh
# Run the full repo verification suite once per pushed commit (replacing CI
# format, lint, test, and docs-drift jobs) inside a single at_sha checkout per
# commit, preserving pushed_shas oldest-first topological order.
set -eu
cd "$(git rev-parse --show-toplevel)"
# shellcheck disable=SC1090,SC1091  # path exported by .githooks/lib/run-local.sh
. "${HOOK_HELPERS:?run from .githooks (scripts/setup-hooks)}"

GENERATED_DOCS='CONFIG.md KEYMAPS.md USAGE.md'
VERIFY_TEST_TIMEOUT_SECONDS=300
VERIFY_DOCS_TIMEOUT_SECONDS=120

verify_commit() {
  ./scripts/check-stylua || return 1
  ./scripts/lint || return 1
  ./scripts/lint-shell || return 1
  run_step 'scripts/test' "$VERIFY_TEST_TIMEOUT_SECONDS" ./scripts/test || return 1
  run_step 'scripts/docs' "$VERIFY_DOCS_TIMEOUT_SECONDS" ./scripts/docs || return 1
  # shellcheck disable=SC2086  # word-split list of generated doc paths
  if ! git diff --exit-code -- $GENERATED_DOCS; then
    echo "error: generated docs are stale; commit the regenerated files" >&2
    return 1
  fi
}

# for loop, not `| while`: a failure must exit this script (fail closed).
# pushed_shas already deduplicates while keeping oldest-first commit order.
shas=$(pushed_shas <"$HOOK_STDIN_FILE") || exit 1
# shellcheck disable=SC2086  # one SHA per word
for sha in $shas; do
  echo "pre-push: verify $(git rev-parse --short "$sha") (stylua, luacheck, shell, test, docs)"
  at_sha "$sha" verify_commit || exit 1
done
