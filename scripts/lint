#!/bin/sh
# Run luacheck at the pinned version: scripts/lint [--] [paths...] (default: .).
# Why: the pre-commit and pre-push hooks and manual runs share this entry
# point, so they cannot drift. A different luacheck release can add or drop
# warnings, so an unpinned run would pass or fail the same tree by machine.
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)
# shellcheck source-path=SCRIPTDIR source=lib/tool-pin.sh
. "$script_dir/lib/tool-pin.sh"

# Bump on purpose and fix the new findings in the same change.
LUACHECK_VERSION=1.2.0
LUACHECK_LUA_VERSION=5.4.8
LUACHECK_BIN=luacheck
INSTALL_HINT="install luacheck $LUACHECK_VERSION: luarocks install luacheck $LUACHECK_VERSION (mise.toml lists lua $LUACHECK_LUA_VERSION to host it)"

resolve_mise_pins "lua@$LUACHECK_LUA_VERSION"
require_pinned_tool "$LUACHECK_BIN" "$LUACHECK_VERSION" '1s/^Luacheck: //p' "$INSTALL_HINT"

if [ "${1:-}" = "--" ]; then
  shift
fi

if [ "$#" -eq 0 ]; then
  cd "$repo_root"
  # --quiet: list only files with findings, so a passing hook stays short.
  exec "$LUACHECK_BIN" --config "$repo_root/.luacheckrc" --quiet --codes --no-color -- .
fi
exec "$LUACHECK_BIN" --config "$repo_root/.luacheckrc" --quiet --codes --no-color -- "$@"
